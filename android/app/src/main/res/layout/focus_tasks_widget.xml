<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/focus_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Tasks Count & Category -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="#FF3B30" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.1"
            android:text="TASKS"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_tasks_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_widget_btn_bg"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="3 PENDING"
            android:textColor="#FF3B30"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Task List Items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Task Item 1 -->
        <LinearLayout
            android:id="@+id/widget_task_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#55555A" />

            <TextView
                android:id="@+id/widget_task_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Complete system audit"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_task_1_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRIT"
                android:textColor="#FF3B30"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Task Item 2 -->
        <LinearLayout
            android:id="@+id/widget_task_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#55555A" />

            <TextView
                android:id="@+id/widget_task_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sync local calendar events"
                android:textColor="#E0E0E6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_task_2_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#FF9500"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Task Item 3 -->
        <LinearLayout
            android:id="@+id/widget_task_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="3dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#55555A" />

            <TextView
                android:id="@+id/widget_task_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Review habit tracking streaks"
                android:textColor="#8E8E93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_task_3_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NORM"
                android:textColor="#8E8E93"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer: Quick Action + Sync Stamp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_tasks_btn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_widget_btn_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="+ ADD TASK"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_tasks_updated_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="Offline"
            android:textColor="#55555A"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
